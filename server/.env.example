# AtlasRegion7 configuration example

# MongoDB connection string.  Replace with your Mongo connection URI.
MONGODB_URI=mongodb://localhost:27017/atlasregion7

# JWT secret key used to sign authentication tokens.  Change this to a
# random string in production.
JWT_SECRET=your-jwt-secret

# Port for the API server.  Defaults to 5000 if not set.
PORT=5000